# Normalise text to LF in the repository, regardless of the contributor OS.
* text=auto eol=lf

# Source and configuration
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.cff text eol=lf

# Binary assets — never convert
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.docx binary
*.xlsx binary

# Generated evidence should not be normalised
artifacts/** -text
app/dist/** -text
