{"type":"before","callId":"wpdc@809","startTime":333361.556,"class":"Frame","method":"evaluateExpression","params":{"expression":"async () => {\n      await new Promise((resolve, reject) => {\n        const req = indexedDB.open(\"pavecon-site-diary\", 1);\n        req.onupgradeneeded = () => {\n          const db = req.result;\n          const stores = [[\"reports\", \"id\"], [\"photos\", \"id\"], [\"register\", \"id\"], [\"memo\", [\"kind\", \"value\"]], [\"settings\", \"key\"]];\n          for (const [name, keyPath] of stores) {\n            if (!db.objectStoreNames.contains(name)) db.createObjectStore(name, {\n              keyPath\n            });\n          }\n        };\n        req.onerror = () => reject(req.error);\n        req.onsuccess = () => {\n          const db = req.result;\n          const tx = db.transaction(\"reports\", \"readwrite\");\n          tx.objectStore(\"reports\").put({\n            id: \"legacy-report\",\n            date: \"2026-01-15\",\n            project: \"Legacy Road\",\n            site: \"Chainage 1+000\",\n            weather: {\n              am: null,\n              pm: null\n            },\n            timeLost: {\n              reason: null,\n              hours: 0\n            },\n            equipment: [],\n            materials: [],\n            workforce: {\n              groups: [\"Own crew\", \"Subcontractors\"],\n              a: [{\n                id: \"c1\",\n                name: \"Raker\",\n                count: 3\n              }],\n              b: [{\n                id: \"c2\",\n                name: \"Steel fixer\",\n                count: 2\n              }]\n            },\n            wip: \"\",\n            visitors: \"\",\n            instructions: \"\",\n            toolbox: {\n              topic: \"Legacy talk\",\n              presenter: \"\",\n              time: \"07:30\",\n              presentIds: [\"c1\"],\n              notes: \"\"\n            },\n            recordedBy: \"Legacy\",\n            recordedAt: null,\n            isSample: false,\n            syncState: \"draft\",\n            updatedAt: Date.now()\n          });\n          tx.oncomplete = () => {\n            db.close();\n            resolve();\n          };\n          tx.onerror = () => reject(tx.error);\n        };\n      });\n    }","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}}}
