{"type":"before","callId":"iuye@2495","startTime":1194485.143,"class":"Frame","method":"evaluateExpression","params":{"expression":"async s => {\n    return new Promise((resolve, reject) => {\n      const req = indexedDB.open(\"pavecon-site-diary\");\n      req.onerror = () => reject(req.error);\n      req.onsuccess = () => {\n        const db = req.result;\n        const tx = db.transaction(s, \"readonly\");\n        const count = tx.objectStore(s).count();\n        count.onsuccess = () => resolve(count.result);\n        count.onerror = () => reject(count.error);\n      };\n    });\n  }","isFunction":true,"arg":{"value":{"s":"reports"},"handles":[]}}}
