{
  "name": "pavecon-site-diary",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Offline-first daily site diary for Pave-Con Ltd — React PWA with a branded PDF export.",
  "author": "garfiel-pixel (https://github.com/garfiel-pixel)",
  "license": "UNLICENSED",
  "homepage": "https://github.com/garfiel-pixel/SITE-diary#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garfiel-pixel/SITE-diary.git",
    "directory": "app"
  },
  "bugs": {
    "url": "https://github.com/garfiel-pixel/SITE-diary/issues"
  },
  "keywords": [
    "site-diary",
    "construction",
    "paving",
    "offline-first",
    "pwa",
    "react",
    "typescript",
    "indexeddb",
    "pdfmake"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "worker:dev": "npm run build && wrangler dev",
    "deploy:worker": "npm run build && wrangler deploy",
    "make-icons": "node scripts/make-icons.mjs",
    "make-fonts": "node scripts/make-fonts.mjs",
    "make-fixtures": "node scripts/make-fixtures.mjs",
    "artifacts": "node scripts/artifacts.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "konsta": "5.5.0",
    "pdfmake": "0.3.14",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@napi-rs/canvas": "1.1.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "lighthouse": "13.6.0",
    "pdfjs-dist": "6.5.438",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "workbox-window": "7.4.1",
    "wrangler": "4.165.0"
  }
}
